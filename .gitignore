# ============================================================================
# Python 运行产物
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/

# PyInstaller
*.manifest
*.spec

# 单元测试 / 覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# 静态类型检查 / Lint 缓存
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ============================================================================
# 虚拟环境（多种命名方式）
# ============================================================================
.venv/
venv/
ENV/
env/
.venv-*/
ENV-*/

# ============================================================================
# 环境变量 & 日志
# ============================================================================
.env
.env.*
!.env.example
*.log
logs/

# ============================================================================
# Flask / SQLAlchemy 本地数据
# ============================================================================
instance/*.db
instance/*.sqlite
instance/*.sqlite3
# instance/config.py 是仓库默认示例模板，不忽略；本地自定义请用 instance/config_local.py
instance/config_local.py
static/uploads/
static/files/*.local.*
# 拓扑演示数据（本地保留，不提交到仓库；文件名含拼写错误，仅作本地测试用）
app/static/files/topology_optimz_position.json

# ============================================================================
# macOS / Windows / 系统文件
# ============================================================================
.DS_Store
.AppleDouble
.LSOverride
Icon
__MACOSX/

Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

